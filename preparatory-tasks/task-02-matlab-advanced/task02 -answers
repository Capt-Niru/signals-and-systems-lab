%% Preparatory Task 2
% Signals and Systems Lab - OUSL

%% 1. Indexing & reordering

a = [9 4 7 2; 1 6 3 5; 3 10 6 4];

>> a(2, 3)
ans =

     3

>> a(0, 2)
error

>> a(5)
ans =

     6

>> a’
ans =

     9     1     3
     4     6    10
     7     3     6
     2     5     4

>> a(:, [2 2 2])
ans =

     4     4     4
     6     6     6
    10    10    10

>> a(1:2:end, 1:2:end)
ans =

     9     7
     3     6

>> a(end:-1:1, :)
ans =

     3    10     6     4
     1     6     3     5
     9     4     7     2

>> max(a)
ans =

     9    10     7     5

>> b = a; b([2 3],[1 4]) = [11 22; 33 44]; b
b =

     9     4     7     2
    11     6     3    22
    33    10     6    44

>> b = a; b(:,2) = []; b
b =

     9     7     2
     1     3     5
     3     6     4

>> log10([1 10 100 0.1])
ans =

     0     1     2    -1
